@model List<LoanItem>

<div class="loan-page">
    <h1 class="loan-title">대출 상품 목록</h1>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>상품명</th>
                        <th>금액</th>
                        <th>이자율</th>
                        <th>기간</th>
                        <th>시작일</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var loan in Model)
                    {
                        <tr>
                            <td class="fw-bold">@loan.Name</td>
                            <td>@loan.Amount.ToString("N0") 원</td>
                            <td>
                                <span class="badge bg-info text-dark">
                                    @loan.InterestRate %
                                </span>
                            </td>
                            <td>@loan.TermInMonths 개월</td>
                            <td>@loan.StartDate.ToShortDateString()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>